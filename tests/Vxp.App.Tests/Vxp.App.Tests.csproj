<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Vxp.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Vxp\Vxp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared with the core tests: builds VideoNow streams and writes a real disc image,
         so the session driver can be run end to end without a retail disc. -->
    <Compile Include="..\Vxp.Core.Tests\SyntheticDisc.cs" Link="SyntheticDisc.cs" />
    <Compile Include="..\Vxp.Core.Tests\SyntheticDiscFile.cs" Link="SyntheticDiscFile.cs" />
    <Compile Include="..\Vxp.Core.Tests\SyntheticBlackAndWhite.cs" Link="SyntheticBlackAndWhite.cs" />
  </ItemGroup>
</Project>
