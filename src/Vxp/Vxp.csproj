<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- A Windows GUI program, so a double click or a launcher opens only the player and
         never a console. It borrows the console of whatever started it, when there is one,
         so the command line still prints; see Ui/Native/ParentConsole.cs. Elsewhere there
         is no such distinction and it stays a plain executable. -->
    <OutputType Condition="$(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')))">WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Vxp</RootNamespace>
    <AssemblyName>vxp</AssemblyName>
    <!-- The release workflow refuses a tag that disagrees with this. -->
    <Version>0.2.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.SDL" Version="2.23.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vxp.Core\Vxp.Core.csproj" />
  </ItemGroup>
</Project>
